---
// Top-strip nav for the v2 chrome surfaces, styled to match the LCARS
// chrome the viewer ships on /sessions / /projects / /topics so the two
// systems read as one product. Inlines the LCARS tokens (sunflower,
// butterscotch, sunflower-muted, fonts) so the strip looks native even
// on the new pages that don't load the viewer's full styles.css.
//
// Each item mirrors the sidebar item geometry (`background:
// --lcars-sunflower-muted`, `border-radius: 0 14px 14px 0`, black text,
// peach-on-hover) plus the sidebar item's three-letter abbreviation
// prefix (`CHT CHAT`, `COR CORRECTIONS`, etc.) so the visual vocabulary
// is identical regardless of which surface you land on first.
// `compact` suppresses the dot + "CHAT ARCHAEOLOGIST" title block.
// On the viewer pages (`/sessions` `/projects` `/topics` `/practice`)
// the React viewer renders its own `.lcars-top-bar` with the same
// dot + title, so showing both stacks two identical title pills.
// Compact mode keeps just the nav pills, sized to read as a
// secondary cross-surface strip below the viewer's primary top bar.
const { current, compact = false } = Astro.props as { current: string; compact?: boolean };
const links: { href: string; short: string; label: string }[] = [
  { href: '/', short: 'TDY', label: 'TODAY' },
  { href: '/audit', short: 'AUD', label: 'AUDIT' },
  { href: '/health', short: 'HLT', label: 'HEALTH' },
  { href: '/blog-drafts', short: 'DFT', label: 'DRAFTS' },
  { href: '/sessions', short: 'SES', label: 'SESSIONS' },
  { href: '/projects', short: 'PRJ', label: 'PROJECTS' },
  { href: '/topics', short: 'TOP', label: 'TOPICS' },
  { href: '/practice', short: 'PRC', label: 'PRACTICE' },
];
---
<nav class={`today-nav ${compact ? 'today-nav--compact' : ''}`} aria-label="Primary surfaces">
  {!compact ? (
    <>
      <span class="today-nav__dot" aria-hidden="true"></span>
      <span class="today-nav__title">CHAT&nbsp;ARCHAEOLOGIST</span>
    </>
  ) : null}
  <ul class="today-nav__links">
    {links.map((l) => (
      <li>
        <a class={`today-nav__item ${l.label === current ? 'today-nav__item--active' : ''}`} href={l.href}>
          <span class="today-nav__item-short">{l.short}</span>
          <span class="today-nav__item-label">{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .today-nav {
    /* Mirror lcars-top-bar geometry: black background, 3px butterscotch
       underline, rounded right corner. Slightly tighter padding than the
       viewer's top-bar since this strip carries nav only, not search +
       title + tier indicator. */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #000000; /* --lcars-bg */
    border-bottom: 3px solid #dd9944; /* --lcars-butterscotch */
    border-radius: 0 16px 16px 0;
    font-family: 'Antonio', 'Oswald', 'Impact', sans-serif; /* --lcars-font-chrome */
  }
  .today-nav__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffcc99; /* --lcars-sunflower */
    flex: 0 0 auto;
  }
  .today-nav__title {
    font-size: 15px;
    letter-spacing: 0.16em;
    color: #ffcc99;
    font-weight: 700;
    white-space: nowrap;
    /* Match lcars-top-bar__title baseline-correction trick. */
    display: inline-flex;
    align-items: center;
    height: 28px;
    line-height: 1;
    padding-bottom: 3px;
  }
  .today-nav__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1 1 auto;
    justify-content: flex-end;
  }
  .today-nav__item {
    /* Mirror .lcars-sidebar__item: muted sunflower bg, dark text, gap +
       abbreviation prefix, rounded right corner. Black text on muted
       sunflower lands 10.25:1 WCAG per the viewer's accessibility note. */
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #d9ad82; /* --lcars-sunflower-muted */
    color: #000000;
    border-radius: 0 14px 14px 0;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 700;
    line-height: 1;
    transition: background 80ms linear;
  }
  .today-nav__item:hover,
  .today-nav__item:focus-visible {
    background: #ffcc99; /* --lcars-sunflower */
    outline: none;
  }
  .today-nav__item--active {
    background: #ff9933; /* --lcars-peach */
    color: #000000;
  }
  .today-nav__item-short {
    font-family: 'JetBrains Mono', 'Consolas', 'Menlo', monospace; /* --lcars-font-mono */
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }
  .today-nav__item-label {
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  @media (max-width: 700px) {
    .today-nav__item-label { display: none; }
    .today-nav__item { padding: 8px 10px; }
  }
  /* Compact mode — no dot + title, smaller padding. Sits *below*
     the viewer's full top-bar on /sessions /projects /topics
     /practice as a secondary cross-surface strip. Reading order:
     primary top-bar (viewer) → compact TodayNav (cross-surface
     pills) → sidebar + content. The strip itself stays on-brand
     (butterscotch underline + sunflower-muted pills) so it reads as
     part of the same chrome system. */
  .today-nav--compact {
    padding: 6px 12px;
    gap: 0;
    border-radius: 0 12px 12px 0;
    margin: 4px 0 0;
  }
  .today-nav--compact .today-nav__links {
    justify-content: flex-start;
  }
  .today-nav--compact .today-nav__item {
    padding: 6px 12px;
    font-size: 10px;
  }
</style>
