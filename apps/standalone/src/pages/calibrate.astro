---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Chat Archaeologist — Calibrate" current="CALIBRATE">
  <main id="main-content" class="calibrate" tabindex="-1">
    <header class="calibrate__head">
      <h1>THRESHOLD CALIBRATION</h1>
      <p class="calibrate__sub">
        Label session pairs in the cos[<span id="band-lo">0.85</span>,
        <span id="band-hi">1.00</span>] band as near-duplicate or not.
        Pairs are sampled stratified by cosine bucket so the whole
        band — including the cos &gt; 0.97 boilerplate zone — gets
        even coverage. Labels save to the same file as
        <code>pnpm label:threshold</code> — switch tools mid-session.
      </p>
      <ul id="bucket-legend" class="calibrate__buckets" aria-label="cosine-bucket coverage" hidden></ul>
    </header>

    {/*
      sr-only live region announces pair advance + section transitions.
      `render()` writes a compact status string here (iter-4 F13).
      role="status" implies aria-live="polite" + aria-atomic="true".
    */}
    <div id="calibrate-announce" role="status" class="sr-only"></div>

    <section id="loading" class="calibrate__state">
      <p>Loading pairs… <span class="calibrate__dim">(scanning embeddings, ~5s on a ~1k corpus)</span></p>
    </section>

    {/*
      role="alert" so a textContent change on #error-msg fires an
      assertive announcement (iter-4 F49). Without this, label-save
      failures revealed via `hidden=false` go silent to SR users.
    */}
    <section id="error" class="calibrate__state" role="alert" hidden>
      <p class="calibrate__error">Couldn't load pairs.</p>
      <pre id="error-msg" class="calibrate__error-detail"></pre>
    </section>

    <section id="empty" class="calibrate__state" hidden>
      <p>All sampled pairs are already labeled. (<span id="done-count">0</span> total in this band.)</p>
      <button type="button" id="show-sweep">Show precision sweep ↓</button>
    </section>

    <section id="labeler" class="calibrate__labeler" hidden>
      <div class="calibrate__progress">
        <span id="progress-text">0 / 0</span>
        <div
          class="calibrate__progress-bar"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-label="labeling progress"
        >
          <div id="progress-fill" class="calibrate__progress-fill"></div>
        </div>
      </div>

      <div class="calibrate__pair">
        <div class="calibrate__cos">
          cos = <span id="pair-cos">—</span>
        </div>

        <div class="calibrate__sessions">
          {/* <article> wrappers replaced with <div> — pair-halves are
              transient label-inputs, not self-contained syndicatable
              content. Avoids landmark inflation. (iter-4 F17) */}
          <div class="calibrate__session calibrate__session--a">
            <h2 id="a-title">Session A</h2>
            <p id="a-preview" class="calibrate__preview"></p>
          </div>

          <div class="calibrate__session calibrate__session--b">
            <h2 id="b-title">Session B</h2>
            <p id="b-preview" class="calibrate__preview"></p>
          </div>
        </div>

        {/* <kbd> aria-hidden so the keyboard hint doesn't become a
            prefix of each button's accessible name. aria-keyshortcuts
            on the button is the modern WAI-ARIA pattern for declaring
            single-key shortcuts. (iter-4 F16) */}
        {/* Defensive glyph prefix on Y/N (iter-5 F30): verdict
            survives grayscale + protanopia. Y/N buttons share the
            same --lcars-pass/--lcars-fail color palette as audit
            badges. */}
        <div class="calibrate__actions">
          <button type="button" id="btn-y" class="calibrate__btn calibrate__btn--y" aria-keyshortcuts="y">
            <kbd aria-hidden="true">Y</kbd> <span aria-hidden="true">✓</span> near-duplicate
          </button>
          <button type="button" id="btn-n" class="calibrate__btn calibrate__btn--n" aria-keyshortcuts="n">
            <kbd aria-hidden="true">N</kbd> <span aria-hidden="true">✗</span> not
          </button>
          <button type="button" id="btn-s" class="calibrate__btn calibrate__btn--s" aria-keyshortcuts="s">
            <kbd aria-hidden="true">S</kbd> skip
          </button>
          <button type="button" id="btn-back" class="calibrate__btn calibrate__btn--back" aria-keyshortcuts="b">
            <kbd aria-hidden="true">B</kbd> back
          </button>
        </div>

        <p class="calibrate__hint">
          Gut-feel based on titles + previews — you don't need to read the full sessions.
          Press <kbd>?</kbd> for shortcuts.
        </p>
        {/* Help affordance — was an alert() in iter-3; replaced iter-4
            (F18) with an inline <details> so SRs can discover it, the
            keyboard `?` handler still toggles open/close, and touch
            users (no `?` key on virtual keyboards) can reach it. */}
        <details id="calibrate-help" class="calibrate__help">
          <summary>Keyboard shortcuts</summary>
          <dl class="calibrate__help-dl">
            <dt><kbd>Y</kbd></dt><dd>near-duplicate</dd>
            <dt><kbd>N</kbd></dt><dd>not a duplicate</dd>
            <dt><kbd>S</kbd></dt><dd>skip (no label written)</dd>
            <dt><kbd>B</kbd> / <kbd>←</kbd></dt><dd>back one pair</dd>
            <dt><kbd>?</kbd></dt><dd>toggle this help</dd>
          </dl>
        </details>
      </div>
    </section>

    <section id="sweep" class="calibrate__sweep" hidden>
      <h2>Precision sweep</h2>
      <p class="calibrate__sub">
        Find the row where precision crosses ~0.95 — that's your new
        <code>DEFAULT_SEMANTIC_DUP_THRESHOLD</code>.
      </p>
      <table id="sweep-table" class="calibrate__sweep-table">
        <thead>
          <tr>
            <th>threshold</th>
            <th>precision [95% CI]</th>
            <th>recall</th>
            <th>n</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <p class="calibrate__sub">
        Paste this table back to me and I'll wire the chosen value into <code>duplicatesSemantic.ts</code>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  /* LCARS-chrome page styles — token literals match the convention used
     by health.astro / playbook.astro / audit.astro / views.astro /
     index.astro. Earlier revisions of this file reached for
     `var(--lcars-dim, #888)` / `var(--lcars-accent, #f80)` etc., but
     those CSS variables are only declared inside `.lcars-root` (the
     React viewer's scope) and this Astro page never enters that
     scope, so every reference fell back to the gray/white/orange
     literals — visually a different app from the rest of the
     LCARS chrome (Wave 3 cohesion audit). Sunflower #FFCC99 is the
     primary text token; #FFCC9999 / cc / 44 / 33 / 22 / 11 are the
     muted ramps. A/B accents reach for the viewer's ice (#99CCFF)
     and violet (#CC99CC) so the LCARS palette is preserved end-to-
     end. */
  main.calibrate {
    padding: 32px 24px 64px;
    max-width: 1100px;
    margin: 0 auto;
    color: #FFCC99;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .calibrate__head h1 {
    font-family: 'Antonio', sans-serif;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 28px;
    margin: 0 0 16px;
  }
  .calibrate__head code,
  .calibrate__sweep code {
    background: #FFCC9911;
    padding: 1px 6px;
    border-radius: 2px;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 12px;
  }
  .calibrate__sub { color: #FFCC9999; font-size: 13px; line-height: 1.6; }
  .calibrate__state { padding: 2rem 0; }
  .calibrate__error { color: var(--lcars-fail); font-weight: 700; font-family: 'Antonio', sans-serif; letter-spacing: 0.08em; }
  .calibrate__error-detail {
    background: #0a0a0a;
    border: 1px solid #FFCC9988;
    border-left: 3px solid var(--lcars-fail);
    padding: 12px 14px;
    border-radius: 3px;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 12px;
    color: #FFCC99cc;
    white-space: pre-wrap;
  }

  .calibrate__progress { display: flex; align-items: center; gap: 1rem; margin: 1rem 0; }
  /* Progress rail bg uses #FFCC9988 (~4.4:1 on #000) to clear WCAG
     1.4.11's 3:1 floor for UI graphical objects. The fill on top is
     solid sunflower, so the visual contrast inside the rail is
     unchanged; only the rail-vs-page-bg contrast improved. */
  .calibrate__progress-bar {
    flex: 1;
    height: 6px;
    background: #FFCC9988;
    border-radius: 3px;
    overflow: hidden;
  }
  .calibrate__progress-fill {
    height: 100%;
    background: #FFCC99;
    transition: width 0.2s ease;
    width: 0%;
  }

  .calibrate__cos {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 13px;
    color: #FFCC9999;
    margin-bottom: 1rem;
  }
  .calibrate__cos span { color: #FFCC99; font-weight: 700; }

  .calibrate__sessions { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
  .calibrate__session {
    background: #0a0a0a;
    border: 1px solid #FFCC9933;
    padding: 14px 16px;
    border-radius: 3px;
    border-left: 3px solid;
    min-height: 8rem;
  }
  /* A/B distinction — borrows the viewer's `--lcars-ice` (#99CCFF)
     and `--lcars-violet` (#CC99CC) tokens so the accent fits the LCARS
     palette instead of arbitrary cyan/magenta. */
  .calibrate__session--a { border-left-color: #99CCFF; }
  .calibrate__session--b { border-left-color: #CC99CC; }
  .calibrate__session h2 {
    font-family: 'Antonio', sans-serif;
    font-size: 14px;
    letter-spacing: 0.12em;
    color: #FFCC99;
    margin: 0 0 8px;
  }
  .calibrate__preview { margin: 0; font-size: 13px; line-height: 1.5; color: #FFCC99cc; }

  .calibrate__actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  /* Button border at #FFCC9988 (~4.4:1) clears WCAG 1.4.11's 3:1 for
     UI control boundaries; the prior #FFCC9955 was ~2.3:1. Hover
     darkens to the same border alpha — single visual state at rest. */
  .calibrate__btn {
    padding: 8px 16px;
    border-radius: 2px;
    border: 1px solid #FFCC9988;
    background: transparent;
    color: #FFCC99;
    cursor: pointer;
    font-family: 'Antonio', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    transition: background 80ms linear, border-color 80ms linear, transform 0.05s ease;
  }
  .calibrate__btn:hover { background: #FFCC9911; border-color: #FFCC99cc; }
  .calibrate__btn:active { transform: translateY(1px); }
  /* Y/N semantic accents — share BaseLayout's --lcars-pass / --lcars-fail
     tokens with audit.astro's verdict badges and index.astro's inline
     status colors. */
  .calibrate__btn--y { border-color: var(--lcars-pass); color: var(--lcars-pass); }
  .calibrate__btn--y:hover { background: rgba(136, 224, 136, 0.1); border-color: var(--lcars-pass); }
  .calibrate__btn--n { border-color: var(--lcars-fail); color: var(--lcars-fail); }
  .calibrate__btn--n:hover { background: rgba(240, 128, 128, 0.1); border-color: var(--lcars-fail); }
  .calibrate__btn kbd {
    display: inline-block;
    padding: 0 0.4em;
    margin-right: 0.4em;
    background: #FFCC9922;
    border-radius: 2px;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 0.85em;
  }

  .calibrate__hint { font-size: 12px; color: #FFCC9999; margin-top: 0.5rem; line-height: 1.5; }
  /* Direct color rather than `opacity: 0.6` so the contrast math is
     locked to the foreground regardless of any parent color override. */
  .calibrate__dim { color: #FFCC9999; }
  /* Keyboard-shortcuts help (iter-4 F18 replaces alert()). Collapsed
     by default; `?` keypress toggles open. Visible-summary doubles as
     the SR landmark. */
  .calibrate__help {
    margin-top: 1rem;
    padding: 8px 12px;
    border: 1px solid #FFCC9988;
    border-radius: 4px;
    background: #0a0a0a;
    font-size: 12px;
  }
  .calibrate__help > summary {
    cursor: pointer;
    font-family: 'Antonio', sans-serif;
    letter-spacing: 0.08em;
    color: #FFCC99;
    padding: 2px 4px;
  }
  .calibrate__help > summary:focus-visible {
    outline: 2px solid #99CCFF;
    outline-offset: 2px;
  }
  .calibrate__help-dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    margin: 8px 0 0;
    color: #FFCC99cc;
    line-height: 1.5;
  }
  .calibrate__help-dl dt {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
  }
  .calibrate__help-dl dd { margin: 0; }

  .calibrate__buckets {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    /* Bumped from 11px to 12px to meet the body-prose floor — these
       legend lines are functional information ("12/25 labeled, 13 more
       needed"), not chrome ALL-CAPS. (iter-4 F44) */
    font-size: 12px;
    color: #FFCC9999;
  }
  .calibrate__buckets li {
    padding: 4px 8px;
    background: #0a0a0a;
    border: 1px solid #FFCC9922;
    border-radius: 2px;
  }
  .calibrate__buckets li.deficit { color: #FF9933; border-color: #FF993355; }

  .calibrate__sweep h2 {
    font-family: 'Antonio', sans-serif;
    font-size: 14px;
    letter-spacing: 0.12em;
    color: #FFCC99;
    margin: 20px 0 8px;
  }
  .calibrate__sweep-table { border-collapse: collapse; margin-top: 1rem; width: 100%; }
  .calibrate__sweep-table th,
  .calibrate__sweep-table td {
    padding: 6px 14px;
    border-bottom: 1px solid #FFCC9922;
    text-align: left;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 12px;
  }
  .calibrate__sweep-table th {
    color: #FFCC9999;
    font-weight: 600;
    font-family: 'Antonio', sans-serif;
    letter-spacing: 0.08em;
  }
  .calibrate__sweep-row--target {
    background: rgba(136, 224, 136, 0.12);
    color: #FFCC99;
    font-weight: 700;
  }

  /* `#show-sweep` button on the empty state — matches the secondary
     ghost-button pattern playbook.astro uses for its copy button. */
  #show-sweep {
    background: transparent;
    color: #FFCC99;
    border: 1px solid #FFCC9955;
    padding: 8px 14px;
    border-radius: 2px;
    font-family: 'Antonio', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 80ms linear, border-color 80ms linear;
  }
  #show-sweep:hover {
    background: #FFCC9911;
    border-color: #FFCC9988;
  }
</style>

<script>
  // Calibration page logic. Vanilla — no framework — to keep the page
  // bundle tiny and the behavior obvious. Talks to /api/calibrate for
  // pair retrieval and label persistence.

  interface Pair {
    id: string;
    a: string;
    b: string;
    aTitle: string;
    bTitle: string;
    aPreview: string;
    bPreview: string;
    cos: number;
  }

  const $ = (id: string): HTMLElement => {
    const el = document.getElementById(id);
    if (el === null) throw new Error(`missing #${id}`);
    return el;
  };

  const state = {
    pairs: [] as Pair[],
    cursor: 0,
    total: 0,
    labeledAtStart: 0,
    history: [] as Array<{ pairId: string; nearDup: boolean }>,
  };

  function showOnly(...sectionIds: string[]): void {
    const all = ['loading', 'error', 'empty', 'labeler', 'sweep'];
    for (const id of all) {
      $(id).hidden = !sectionIds.includes(id);
    }
    // SR a11y: when the visible state swaps (loading → labeler →
    // empty / error / sweep), focus the newly-visible section so
    // assistive tech announces the new content. Otherwise the
    // section change is silent — the user's virtual cursor stays
    // wherever it was on the stale section.
    const firstVisible = sectionIds[0];
    if (firstVisible !== undefined) {
      const target = $(firstVisible);
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: false });
    }
  }

  interface Bucket {
    lo: number;
    hi: number;
    isLast: boolean;
    target: number;
    alreadyLabeled: number;
    deficit: number;
    sampled: number;
  }

  async function init(): Promise<void> {
    showOnly('loading');
    try {
      const res = await fetch('/api/calibrate?action=init&n=100&strata=4');
      const data = (await res.json()) as {
        ok: boolean;
        error?: string;
        hint?: string;
        pairs?: Pair[];
        labeledCount?: number;
        total?: number;
        band?: [number, number];
        strata?: number;
        buckets?: Bucket[];
        poolSize?: number;
      };
      if (!data.ok || !Array.isArray(data.pairs)) {
        $('error-msg').textContent = (data.error ?? 'unknown') + (data.hint ? '\n\n' + data.hint : '');
        showOnly('error');
        return;
      }
      state.pairs = data.pairs;
      state.labeledAtStart = data.labeledCount ?? 0;
      state.total = data.total ?? data.pairs.length;
      if (Array.isArray(data.band)) {
        $('band-lo').textContent = data.band[0].toFixed(2);
        $('band-hi').textContent = data.band[1].toFixed(2);
      }
      renderBuckets(data.buckets ?? [], data.strata ?? 4);
      if (state.pairs.length === 0) {
        $('done-count').textContent = String(state.total);
        showOnly('empty');
        return;
      }
      state.cursor = 0;
      showOnly('labeler');
      render();
    } catch (err) {
      $('error-msg').textContent = String(err);
      showOnly('error');
    }
  }

  function renderBuckets(buckets: Bucket[], _strata: number): void {
    const legend = $('bucket-legend') as HTMLUListElement;
    legend.innerHTML = '';
    if (buckets.length === 0) {
      legend.hidden = true;
      return;
    }
    // Per-bucket progress: "X/target labeled, deficit more needed".
    // Highlights buckets that still need work and buckets the corpus
    // can't fill (deficit > 0 but sampled < deficit — out of pairs).
    for (const b of buckets) {
      const li = document.createElement('li');
      const close = b.isLast ? ']' : ')';
      const remaining = b.deficit;
      let label = `[${b.lo.toFixed(4)}, ${b.hi.toFixed(4)}${close}: ${b.alreadyLabeled}/${b.target} labeled`;
      if (remaining > 0) label += `, ${remaining} more needed`;
      if (b.deficit > 0 && b.sampled < b.deficit) {
        label += ` (corpus only has ${b.sampled})`;
      }
      li.textContent = label;
      if (remaining > 0) li.classList.add('deficit');
      legend.appendChild(li);
    }
    legend.hidden = false;
  }

  function render(): void {
    const p = state.pairs[state.cursor];
    if (p === undefined) {
      // Finished — auto-load the sweep.
      void showSweep();
      return;
    }
    const totalPosition = state.labeledAtStart + state.cursor + 1;
    $('progress-text').textContent = `${totalPosition} / ${state.total}`;
    const fill = $('progress-fill') as HTMLElement;
    const pct = (totalPosition / Math.max(1, state.total)) * 100;
    fill.style.width = `${pct}%`;
    // Keep aria-valuenow on the progressbar parent in sync with the
    // visual fill so SR users can poll the percentage on demand.
    const progressBar = fill.parentElement;
    if (progressBar !== null) {
      progressBar.setAttribute('aria-valuenow', String(Math.round(pct)));
    }

    $('pair-cos').textContent = p.cos.toFixed(3);
    $('a-title').textContent = p.aTitle;
    $('b-title').textContent = p.bTitle;
    $('a-preview').textContent = p.aPreview;
    $('b-preview').textContent = p.bPreview;
    // F13: announce the pair advance to SRs. The role="status" region
    // is polite + atomic, so it re-reads on each textContent swap.
    // Compact summary — full prose is in the visible pair already.
    const announce = $('calibrate-announce');
    announce.textContent =
      `Pair ${totalPosition} of ${state.total}, cosine ${p.cos.toFixed(3)}. ` +
      `Session A: ${p.aTitle.slice(0, 60)}. Session B: ${p.bTitle.slice(0, 60)}.`;
  }

  async function label(nearDup: boolean): Promise<void> {
    const p = state.pairs[state.cursor];
    if (p === undefined) return;
    try {
      await fetch('/api/calibrate', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'x-requested-with': 'chat-arch-calibrate',
        },
        body: JSON.stringify({ pairId: p.id, nearDup, cos: p.cos }),
      });
      state.history.push({ pairId: p.id, nearDup });
      state.cursor += 1;
      render();
    } catch (err) {
      // Per-keypress label fail is recoverable — show the error inline
      // but don't advance, so the user can retry the same pair.
      console.error('label save failed', err);
      $('error-msg').textContent = `Save failed on ${p.id}: ${String(err)}\nYou can retry the same key.`;
      $('error').hidden = false;
    }
  }

  function skip(): void {
    state.cursor += 1;
    render();
  }

  function back(): void {
    if (state.cursor > 0) {
      state.cursor -= 1;
      state.history.pop();
      render();
    }
  }

  async function showSweep(): Promise<void> {
    showOnly('sweep');
    try {
      const res = await fetch('/api/calibrate?action=sweep');
      const data = (await res.json()) as {
        ok: boolean;
        sweep: Array<{
          threshold: number;
          precision: number;
          ciLow: number;
          ciHigh: number;
          recall: number;
          n: number;
        }>;
      };
      const tbody = $('sweep-table').querySelector('tbody');
      if (tbody === null) return;
      tbody.innerHTML = '';
      // Mark the highest-precision row whose CI lower bound clears 0.90
      // (still has reasonable recall) — a useful visual default for the
      // "where does precision *statistically* cross our quality bar"
      // question. Using the lower bound (not the point estimate) so a
      // 0.96-with-CI-of-[0.70,0.99] row doesn't masquerade as the answer.
      const targetIdx = data.sweep.findIndex((r) => r.ciLow >= 0.9 && r.n >= 5);
      for (let i = 0; i < data.sweep.length; i++) {
        const r = data.sweep[i]!;
        const tr = document.createElement('tr');
        if (i === targetIdx) tr.classList.add('calibrate__sweep-row--target');
        tr.innerHTML =
          `<td>${r.threshold.toFixed(2)}</td>` +
          `<td>${r.precision.toFixed(2)} [${r.ciLow.toFixed(2)}–${r.ciHigh.toFixed(2)}]</td>` +
          `<td>${r.recall.toFixed(2)}</td>` +
          `<td>${r.n}</td>`;
        tbody.appendChild(tr);
      }
      if (data.sweep.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="opacity:0.6">(no labels yet — label at least 20 pairs to see a useful sweep)</td></tr>';
      }
    } catch (err) {
      console.error('sweep load failed', err);
    }
  }

  // Keyboard handlers — global, with input/textarea guard so any future
  // text input on the page doesn't intercept.
  document.addEventListener('keydown', (ev) => {
    const target = ev.target as HTMLElement | null;
    if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) return;
    if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
    const key = ev.key.toLowerCase();
    if (key === 'y') { ev.preventDefault(); void label(true); }
    else if (key === 'n') { ev.preventDefault(); void label(false); }
    else if (key === 's') { ev.preventDefault(); skip(); }
    else if (key === 'b' || ev.key === 'ArrowLeft') { ev.preventDefault(); back(); }
    else if (key === '?') {
      ev.preventDefault();
      const help = document.getElementById('calibrate-help') as HTMLDetailsElement | null;
      if (help) {
        help.open = !help.open;
        if (help.open) {
          // Focus the summary so SRs read the open state + dl content.
          const summary = help.querySelector('summary') as HTMLElement | null;
          summary?.focus();
        }
      }
    }
  });

  // Click handlers
  $('btn-y').addEventListener('click', () => void label(true));
  $('btn-n').addEventListener('click', () => void label(false));
  $('btn-s').addEventListener('click', () => skip());
  $('btn-back').addEventListener('click', () => back());
  $('show-sweep').addEventListener('click', () => void showSweep());

  void init();
</script>
