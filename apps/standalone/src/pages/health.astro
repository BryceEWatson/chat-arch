---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { readContinuumHealth } from '../lib/readSidecars.ts';

const health = await readContinuumHealth();

function fmtPct(v: number): string {
  return `${(v * 100).toFixed(1)}%`;
}

function fmtTime(iso: string | null | undefined): string {
  if (typeof iso !== 'string') return '—';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}
---
<BaseLayout title="Chat Archaeologist — Health" current="HEALTH">
  <main id="main-content" class="health" tabindex="-1">
    <h1>CONTINUUM HEALTH</h1>
    {health === null ? (
      <p class="health__empty">
        No <code>analysis/continuum-health.json</code> on disk yet. Run a
        rescan and reload.
      </p>
    ) : (
      <>
        <section class="health__top">
          <div class="health__metric">
            <span class="health__metric-label">consecutive successes</span>
            <span class="health__metric-value">{health.consecutiveSuccesses}</span>
          </div>
          <div class="health__metric">
            <span class="health__metric-label">last scan</span>
            <time
              class="health__metric-value"
              datetime={health.lastScanAt}
              aria-label={health.lastScanAt}
            >
              {fmtTime(health.lastScanAt)}
            </time>
          </div>
          <div class="health__metric">
            <span class="health__metric-label">last successful scan</span>
            {health.lastSuccessfulScanAt ? (
              <time
                class="health__metric-value"
                datetime={health.lastSuccessfulScanAt}
                aria-label={health.lastSuccessfulScanAt}
              >
                {fmtTime(health.lastSuccessfulScanAt)}
              </time>
            ) : (
              <span class="health__metric-value">—</span>
            )}
          </div>
          <div class="health__metric">
            <span class="health__metric-label">new since last scan</span>
            <span class="health__metric-value">{health.newSessionsSinceLast}</span>
          </div>
        </section>

        <section class="health__row" aria-labelledby="health-sources-h">
          <h2 id="health-sources-h">SOURCES SCANNED</h2>
          <p>{health.sourcesScanned.join(', ')}</p>
        </section>

        <section class="health__row" aria-labelledby="health-entries-h">
          <h2 id="health-entries-h">ENTRIES BY STATUS</h2>
          <table class="health__table" aria-labelledby="health-entries-h">
            <tbody>
              <tr><th scope="row">ok</th><td>{health.entriesByStatus.ok}</td></tr>
              <tr><th scope="row">missing</th><td>{health.entriesByStatus.missing}</td></tr>
              <tr><th scope="row">crashed</th><td>{health.entriesByStatus.crashed}</td></tr>
              <tr><th scope="row">pruned</th><td>{health.entriesByStatus.pruned}</td></tr>
            </tbody>
          </table>
        </section>

        <section class="health__row" aria-labelledby="health-warnings-h">
          <h2 id="health-warnings-h">
            WARNINGS
            {health.warnings.length === 0
              ? ' — none'
              : ` — ${health.warnings.length} active`}
          </h2>
          {health.warnings.length === 0 ? (
            <p class="health__nowarn">
              <span aria-hidden="true">✓ </span>
              All sources under threshold.
            </p>
          ) : (
            <ul>
              {health.warnings.map((w) => {
                const isRate = w.kind.includes('rate');
                const unit = isRate ? '' : (w.kind.includes('count') ? ' (count)' : '');
                return (
                  <li>
                    <code>{w.source}</code> · {w.kind} =
                    {' '}<strong>{typeof w.value === 'number' ? (isRate ? fmtPct(w.value) : w.value) : String(w.value)}</strong>{unit}
                    {' '}(threshold {isRate ? fmtPct(w.threshold) : w.threshold}{unit})
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </>
    )}
  </main>
</BaseLayout>

<style>
  main.health {
    max-width: 880px;
    margin: 0 auto;
    padding: 32px 24px 64px;
    color: var(--lcars-sunflower);
    font-family: 'IBM Plex Sans', sans-serif;
  }
  main.health h1 {
    font-family: 'Antonio', sans-serif;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 28px;
    margin: 0 0 24px;
  }
  .health__empty code {
    background: #FFCC9911;
    padding: 1px 6px;
    border-radius: 3px;
    font-family: 'JetBrains Mono', monospace;
  }
  .health__top { display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .health__metric { background: #0a0a0a; border: 1px solid #FFCC9933; padding: 12px 16px; border-radius: 4px; min-width: 200px; }
  .health__metric-label { display: block; font-size: 12px; line-height: 1.45; color: #FFCC9999; letter-spacing: 0.08em; }
  .health__metric-value { display: block; font-size: 18px; font-family: 'JetBrains Mono', monospace; margin-top: 4px; }
  .health__row h2 { font-family: 'Antonio', sans-serif; font-size: 14px; letter-spacing: 0.1em; color: var(--lcars-sunflower); margin: 20px 0 8px; }
  .health__row p { font-family: 'JetBrains Mono', monospace; font-size: 13px; margin: 0; }
  .health__table { border-collapse: collapse; }
  .health__table th { text-align: left; padding: 4px 16px 4px 0; color: #FFCC9999; font-weight: 600; font-family: 'JetBrains Mono', monospace; }
  .health__table td { padding: 4px 0; font-family: 'JetBrains Mono', monospace; }
  .health__nowarn { color: var(--lcars-pass); }
  .health__row ul { padding-left: 18px; font-family: 'JetBrains Mono', monospace; font-size: 13px; }
  .health__row li { padding: 4px 0; color: #FFCC99cc; }
</style>
