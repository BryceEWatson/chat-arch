                  {n.sentiment}
                </span>
                <span class="today__story-title">{n.title}</span>
                <a class="today__story-project" href={`/projects/${n.projectId}`}>
                  {n.projectId}
                </a>
                <span class="today__story-date">
                  {n.generatedAt.slice(0, 10)}
                </span>
