      ) : (
        <p class="today__row-summary">
          <a href="/blog-drafts">
            {draftFinals} draft{draftFinals === 1 ? '' : 's'} · {draftPrompts} prompt scaffold{draftPrompts === 1 ? '' : 's'} →
          </a>
