---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readBlogDraft, readAuditResults } from '../../lib/readSidecars.ts';

const slug = Astro.params.slug ?? '';
// Conservative slug sanitization — defeats path traversal even though
// readBlogDraft asserts containment internally.
const safe = /^[A-Za-z0-9._-]{1,200}$/.test(slug) ? slug : '';
const draft = safe === '' ? null : await readBlogDraft(safe);
const audit = await readAuditResults();

// Pull every [SID:...] citation out of the draft body so the page can
// render an inline F-audit verdict per cited session.
const citations = new Set<string>();
if (draft !== null) {
  const re = /\[SID:([A-Za-z0-9_-]+)\]/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(draft.markdown)) !== null) {
    if (m[1]) citations.add(m[1]);
  }
}

interface SessionAuditRow {
  sessionId: string;
  totalClaims: number;
  pass: number;
  fail: number;
  inconclusive: number;
  passRate: number;
}

const auditRows: SessionAuditRow[] = [];
if (audit !== null) {
  const acc = new Map<string, { pass: number; fail: number; inconclusive: number }>();
  for (const r of audit.results) {
    if (!citations.has(r.sessionId)) continue;
    const slot = acc.get(r.sessionId) ?? { pass: 0, fail: 0, inconclusive: 0 };
    slot[r.outcome] += 1;
    acc.set(r.sessionId, slot);
  }
  for (const [sessionId, slot] of acc) {
    const total = slot.pass + slot.fail + slot.inconclusive;
    auditRows.push({
      sessionId,
      totalClaims: total,
      pass: slot.pass,
      fail: slot.fail,
      inconclusive: slot.inconclusive,
      passRate: total === 0 ? 0 : slot.pass / total,
    });
  }
}

const overallPass = auditRows.reduce((a, r) => a + r.pass, 0);
const overallFail = auditRows.reduce((a, r) => a + r.fail, 0);
const overallInc = auditRows.reduce((a, r) => a + r.inconclusive, 0);
const overallTotal = overallPass + overallFail + overallInc;
const overallRate = overallTotal === 0 ? 0 : overallPass / overallTotal;
---
<BaseLayout title={draft !== null ? `Draft — ${slug}` : 'Draft not found'} current="DRAFTS">
  <main id="main-content" class="draft" tabindex="-1">
    <p class="draft__crumb">
      <a href="/blog-drafts"><span aria-hidden="true">← </span>all drafts</a>
    </p>
    <h1>{slug || 'Untitled draft'}</h1>

    {draft === null ? (
      <p class="draft__empty">
        No blog draft was found for this slug. Drafts are generated
        when the blog-candidate selector runs and the chat-answer
        agent renders each candidate to markdown — run SCAN LOCAL
        from the DATA panel to refresh.
      </p>
    ) : (
      <>
        {draft.isPrompt ? (
          <p class="draft__notice" role="note">
            <span aria-hidden="true">⚠ </span>
            This page is the seed prompt for this draft, not the
            final article. The chat-answer agent will produce the
            written-out markdown on the next scan, drawing from the
            cited member sessions below.
          </p>
        ) : (
          <section class="draft__audit" aria-labelledby="draft-audit-h">
            <h2 id="draft-audit-h">CLAIM-VERIFICATION VERDICT</h2>
            <p>
              <strong>{(overallRate * 100).toFixed(0)}%</strong> claim-pass
              rate ({overallPass}/{overallTotal} verified, {overallFail} failed,
              {overallInc} inconclusive across {auditRows.length} cited session(s)).
              {overallRate >= 0.8 ? (
                <span class="draft__pass">
                  <span aria-hidden="true"> ✓</span> passes 80% bar
                </span>
              ) : (
                <span class="draft__fail">
                  <span aria-hidden="true"> ✗</span> below 80% bar
                </span>
              )}
            </p>
            {auditRows.length > 0 ? (
              <table class="draft__audit-table" aria-labelledby="draft-audit-h">
                <thead>
                  <tr>
                    <th scope="col">session</th>
                    <th scope="col">pass</th>
                    <th scope="col">fail</th>
                    <th scope="col">inconclusive</th>
                    <th scope="col">rate</th>
                  </tr>
                </thead>
                <tbody>
                  {auditRows.map((r) => (
                    <tr>
                      <td><code>{r.sessionId}</code></td>
                      <td>{r.pass}</td>
                      <td>{r.fail}</td>
                      <td>{r.inconclusive}</td>
                      <td>{(r.passRate * 100).toFixed(0)}%</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="draft__no-cites">No audit data for the cited sessions yet.</p>
            )}
          </section>
        )}

        <section class="draft__body" aria-labelledby="draft-body-h">
          <h2 id="draft-body-h">{draft.isPrompt ? 'DRAFT PROMPT' : 'DRAFT'}</h2>
          <pre tabindex="0">{draft.markdown}</pre>
        </section>
      </>
    )}
  </main>
</BaseLayout>

<style>
  main.draft { max-width: 880px; margin: 0 auto; padding: 32px 24px 64px; color: var(--lcars-sunflower); font-family: 'IBM Plex Sans', sans-serif; }
  main.draft h1 { font-family: 'Antonio', sans-serif; letter-spacing: 0.08em; font-size: 24px; margin: 0 0 16px; word-break: break-all; }
  main.draft h2 { font-family: 'Antonio', sans-serif; letter-spacing: 0.1em; font-size: 14px; color: var(--lcars-sunflower); margin: 20px 0 8px; }
  .draft__crumb a { color: #FFCC99cc; text-decoration: none; font-size: 12px; }
  .draft__crumb a:focus-visible {
    outline: 2px solid var(--lcars-sunflower);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .draft__notice {
    background: rgba(221, 153, 68, 0.13);
    border-left: 3px solid var(--lcars-butterscotch);
    padding: 12px 16px;
    border-radius: 0 4px 4px 0;
    color: var(--lcars-warn);
  }
  .draft__notice code { background: #00000044; padding: 1px 4px; border-radius: 2px; font-family: 'JetBrains Mono', monospace; }
  .draft__audit { margin-top: 16px; }
  .draft__pass { color: var(--lcars-pass); }
  .draft__fail { color: var(--lcars-fail); }
  .draft__audit-table { border-collapse: collapse; margin-top: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; }
  .draft__audit-table th, .draft__audit-table td { padding: 4px 12px; text-align: left; border-bottom: 1px solid #FFCC9988; }
  .draft__audit-table tbody tr:hover {
    background: rgba(255, 204, 153, 0.04);
  }
  .draft__no-cites { color: #FFCC9999; font-style: italic; }
  .draft__body pre {
    background: #0a0a0a;
    border: 1px solid #FFCC9988;
    padding: 16px 20px;
    border-radius: 4px;
    color: var(--lcars-sunflower);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.7;
    max-width: 78ch;
    overflow-x: auto;
    white-space: pre-wrap;
  }
  .draft__body pre:focus-visible {
    outline: 2px solid var(--lcars-ice);
    outline-offset: 2px;
  }
</style>
